&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">CallQueueId&lt;/span> &lt;span class="p">=&lt;/span> &lt;span class="nv">$cq&lt;/span>&lt;span class="p">.&lt;/span>&lt;span class="py">Identity&lt;/span>
